{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:geoiplus:schema:model3d-command-payload-align-eave:v1",
  "title": "ALIGN_EAVE payload",
  "description": "Align a eave line (v0.2 C.7, D.3; v0.3 §6; spec §10.7). ",
  "type": "object",
  "properties": {
    "edgeId": { "$ref": "urn:geoiplus:schema:model3d-common:v1#/$defs/EntityId" },
    "mode": {
      "enum": ["KEEP_RIDGE", "KEEP_PLANES", "FIT_MEASUREMENTS"],
      "description": "Any other mode is INVALID_PAYLOAD / INVALID_MODE (v0.2 C.7)."
    },
    "targetLine": {
      "$ref": "urn:geoiplus:schema:model3d-common:v1#/$defs/Line3",
      "description": "Required except for KEEP_PLANES; with KEEP_PLANES an arbitrary target is a domain refusal (GT-09), not a schema error."
    },
    "hardConstraintIds": { "$ref": "urn:geoiplus:schema:model3d-common:v1#/$defs/EntityIdList" },
    "measurementIds": {
      "$ref": "urn:geoiplus:schema:model3d-common:v1#/$defs/EntityIdList",
      "description": "FIT_MEASUREMENTS only."
    }
  },
  "required": ["edgeId", "mode"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "mode": { "enum": ["KEEP_RIDGE"] } }, "required": ["mode"] },
      "then": { "required": ["targetLine"] }
    },
    {
      "if": { "properties": { "mode": { "const": "FIT_MEASUREMENTS" } }, "required": ["mode"] },
      "then": { "required": ["measurementIds"] }
    }
  ],
  "$comment": "`edgeId`, `mode`, `targetLine`, `hardConstraintIds` as in v0.2 D.3; [P] measurementIds; [A] targetLine optional for FIT_MEASUREMENTS."
}
