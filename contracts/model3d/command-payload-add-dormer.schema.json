{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:geoiplus:schema:model3d-command-payload-add-dormer:v1",
  "title": "ADD_DORMER payload",
  "description": "Add a dormer as a separate BuildingInstallation body (v0.3 §6 F-36; v0.2 C.16; spec §10.11).",
  "type": "object",
  "properties": {
    "roofFaceId": { "$ref": "urn:geoiplus:schema:model3d-common:v1#/$defs/EntityId" },
    "dormerType": { "enum": ["FLAT", "GABLE"] },
    "outline": {
      "type": "array",
      "items": { "$ref": "urn:geoiplus:schema:model3d-common:v1#/$defs/V3" },
      "minItems": 3,
      "description": "Outline on the roof face."
    },
    "heightM": {
      "$ref": "urn:geoiplus:schema:model3d-common:v1#/$defs/PositiveLength",
      "description": "Back (uphill) wall height: the top is at the highest outline corner z + heightM (D-3D20-2)."
    },
    "ridgeRiseM": {
      "$ref": "urn:geoiplus:schema:model3d-common:v1#/$defs/PositiveLength",
      "description": "GABLE only: ridge height above the wall top (D-3D20-3)."
    },
    "measurementId": {
      "$ref": "urn:geoiplus:schema:model3d-common:v1#/$defs/EntityId",
      "description": "Size from a plane-fit measurement."
    }
  },
  "required": ["roofFaceId", "dormerType", "outline"],
  "additionalProperties": false,
  "anyOf": [{ "required": ["heightM"] }, { "required": ["measurementId"] }],
  "if": { "properties": { "dormerType": { "const": "GABLE" } }, "required": ["dormerType", "heightM"] },
  "then": { "required": ["ridgeRiseM"] },
  "$comment": "[P] Field names. Dimensions: D-3D20-2 (FLAT), D-3D20-3 (GABLE); Q-38 closed."
}
