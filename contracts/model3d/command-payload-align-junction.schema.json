{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:geoiplus:schema:model3d-command-payload-align-junction:v1",
  "title": "ALIGN_JUNCTION payload",
  "description": "Reconcile a node of 3+ planes (v0.2 C.9; v0.3 §6; spec §10.8 rule 3). CANCEL of v0.2 is a client cancel.",
  "type": "object",
  "properties": {
    "vertexId": { "$ref": "urn:geoiplus:schema:model3d-common:v1#/$defs/EntityId" },
    "faceIds": {
      "$ref": "urn:geoiplus:schema:model3d-common:v1#/$defs/EntityIdList",
      "type": "array",
      "minItems": 3,
      "description": "The planes of the node."
    },
    "mode": { "enum": ["KEEP_PRIMARY_PLANE", "REFIT_SELECTED_PLANES"] },
    "primaryFaceId": {
      "$ref": "urn:geoiplus:schema:model3d-common:v1#/$defs/EntityId",
      "description": "KEEP_PRIMARY_PLANE: the plane that stays unchanged (GT-19)."
    },
    "movableFaceIds": {
      "$ref": "urn:geoiplus:schema:model3d-common:v1#/$defs/EntityIdList",
      "type": "array",
      "minItems": 1,
      "description": "REFIT_SELECTED_PLANES: planes that may be refitted."
    },
    "maxDisplacementM": {
      "$ref": "urn:geoiplus:schema:model3d-common:v1#/$defs/NonNegativeLength",
      "description": "Displacement limit (v0.2 C.9)."
    }
  },
  "required": ["vertexId", "faceIds", "mode"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "KEEP_PRIMARY_PLANE" } }, "required": ["mode"] },
      "then": { "required": ["primaryFaceId"] }
    },
    {
      "if": { "properties": { "mode": { "const": "REFIT_SELECTED_PLANES" } }, "required": ["mode"] },
      "then": { "required": ["movableFaceIds"] }
    }
  ],
  "$comment": "[P] Field names."
}
