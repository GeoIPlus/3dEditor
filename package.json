{
  "name": "3deditor",
  "version": "0.0.0",
  "private": true,
  "description": "3DQM: server-only LoD2 geometry kernel, its service and plan (GeoIPlus)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run types && npm run check:arch && npm run check:docs && npm run backlog:sync -- --check && npm test && npm run golden",
    "test": "vitest run --project unit && node --test tools/check-docs.test.mjs",
    "types": "tsc -p tsconfig.json",
    "check:arch": "node tools/check-arch/cli.mjs",
    "check:docs": "node tools/check-docs-run.mjs",
    "backlog:sync": "node tools/backlog-sync/cli.mjs",
    "golden": "vitest run --project golden --passWithNoTests",
    "fixtures": "node tools/golden-fixtures/cli.mjs",
    "bench": "vitest bench --run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "geographiclib-geodesic": "2.2.0",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "4.0.18"
  }
}
